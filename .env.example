# Monolegal Billing - local development environment template.
#
# Copy this file to `.env` (git-ignored) and adjust locally:
#   Windows PowerShell: Copy-Item .env.example .env
#   bash:               cp .env.example .env
#
# `.env.example` must never contain real credentials. Every value below is a
# local-only default that matches `compose.yaml` (MongoDB + Mailpit, nothing else).
#
# Variable names are fixed by docs/SPECIFICATION.md section 8:
#   MONGO_CONNECTION_STRING, MAIL__HOST, MAIL__PORT
# While the API does not load .env files, it does read MONGO_CONNECTION_STRING and
# MONGO_DATABASE from the process environment; appsettings.Development.json supplies
# local defaults. The MAIL__* keys are not bound yet (Phase 4).
# Copying this file does not change API ports, CORS, or Angular configuration.

# --- MongoDB (compose service: mongo) ---
# Host and port come from compose.yaml: 127.0.0.1:27017.
MONGO_CONNECTION_STRING=mongodb://localhost:27017
# Database that holds the `clientes`, `facturas` and `intentosNotificacion` collections.
MONGO_DATABASE=monolegal_billing

# --- Mailpit SMTP (compose service: mailpit) ---
# Host and port come from compose.yaml: 127.0.0.1:1025.
MAIL__HOST=localhost
MAIL__PORT=1025
# Proposed sender address for local Mailpit capture; never use a real recipient.
MAIL__FROM=no-reply@example.test
# Mailpit does not require TLS for local capture.
MAIL__ENABLE_TLS=false
# Mailpit does not authenticate. Leave empty; never put real SMTP credentials here.
MAIL__USER=
MAIL__PASSWORD=
# Mailpit web UI for inspecting captured mail.
MAILPIT_UI_URL=http://localhost:8025

# --- API ---
# HTTP port from src/Monolegal.Billing.Api/Properties/launchSettings.json (profile "http").
API_PORT=5091
API_BASE_URL=http://localhost:5091

# --- Frontend ---
# Proposed Angular origin. CORS is not configured in the Phase 1 API.
ANGULAR_PORT=4200
CORS__ALLOWED_ORIGINS=http://localhost:4200
